generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
}

// ─── Org / Tenant ────────────────────────────────────────────────────────────
model Org {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  scanJobs  ScanJob[]
  findings  Finding[]
}

// ─── Scan Job (each uploaded file or API pull) ────────────────────────────────
model ScanJob {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id])
  sourceTool  String    // "qualys" | "nessus" | "openvas" | "tenable" | "csv"
  fileName    String?
  status      String    @default("pending") // pending | processing | done | error
  findingCount Int      @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  findings    Finding[]
}

// ─── Universal Finding Schema (UFS) ──────────────────────────────────────────
model Finding {
  id              String   @id @default(cuid())
  orgId           String
  org             Org      @relation(fields: [orgId], references: [id])
  scanJobId       String
  scanJob         ScanJob  @relation(fields: [scanJobId], references: [id])

  // Identity
  sourceTool      String   // qualys | nessus | openvas | tenable | crowdstrike
  pluginId        String?  // tool-specific plugin/check ID
  cveId           String?  // e.g. CVE-2021-44228

  // Asset
  host            String?
  ip              String?
  port            String?
  protocol        String?
  assetGroup      String?

  // Vulnerability
  title           String
  description     String?
  solution        String?

  // Risk
  severity        String   // Critical | High | Medium | Low | Info
  cvssScore       Float?   // 0.0 - 10.0
  cvssVector      String?
  epssScore       Float?   // 0.0 - 1.0 (enriched from NVD)
  isKev           Boolean  @default(false) // CISA Known Exploited Vulnerability

  // Status / SLA
  status          String   @default("open") // open | resolved | accepted | sla_breach
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @default(now())
  slaDeadline     DateTime?

  createdAt       DateTime @default(now())

  @@index([orgId])
  @@index([cveId])
  @@index([severity])
  @@index([status])
}

// ─── SOAR Routing Rules ───────────────────────────────────────────────────────
model SoarRule {
  id        String   @id @default(cuid())
  orgId     String
  category  String   // Cloud Altitude | Network Runway | App Security Check | Identity PreCheck
  leadName  String
  leadRole  String
  avatar    String
  autoJira  Boolean  @default(false)
  autoSnow  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, category])
  @@index([orgId])
}

// ─── SOAR Auto-Generated Tickets ─────────────────────────────────────────────
model SoarTicket {
  id         String   @id   // e.g. JIRA-SEC-1249 | SNOW-INC-9281
  orgId      String
  cveId      String?
  title      String
  asset      String
  assignee   String
  avatar     String
  severity   String           // Critical | High | Medium | Low
  status     String           // Open | Dispatched | Remediation In-Flight | Resolved
  system     String           // Jira | ServiceNow
  slaLimitMs Float
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([status])
  @@index([severity])
}

// ─── SOAR Dispatch Audit Logs ─────────────────────────────────────────────────
model SoarLog {
  id        String   @id @default(cuid())
  orgId     String
  message   String
  createdAt DateTime @default(now())

  @@index([orgId])
}

// ─── Login Attempts Tracker ───────────────────────────────────────────────────
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  firstName String?
  lastName  String?
  provider  String   // "google" | "credentials"
  status    String   // "success" | "failed"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── SaaS Upgrade Requests Logger ─────────────────────────────────────────────
model UpgradeRequest {
  id         String   @id @default(cuid())
  clientName String
  userEmail  String
  moduleName String
  createdAt  DateTime @default(now())

  @@index([userEmail])
}

